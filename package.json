{
  "name": "codelab-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:real": "playwright test --config playwright.real.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:classrooms:real": "./scripts/test-classrooms-real",
    "test:questions:real": "./scripts/test-classrooms-real questions",
    "test:activities:real": "./scripts/test-classrooms-real activities"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
